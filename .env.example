# Clerk — from https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional alias for Vercel (read at runtime, not inlined at build)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# App routes (optional overrides)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Who can access after sign-in (comma-separated for multiple)
ALLOWED_EMAIL_DOMAIN=sportradar.com
